{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "news",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],

  // Finished page lives here; the fetch handler only reads this string.
  "kv_namespaces": [
    { "binding": "NEWS", "id": "63f8142b11ed410bb1496dbc53f72c5c" }
  ],

  // Concept text model + FLUX.1 Schnell for the banner.
  "ai": { "binding": "AI" },

  // Rebuild every two hours, on the hour (UTC).
  "triggers": { "crons": ["0 */2 * * *"] },

  // Custom domain; wrangler manages the DNS record and certificate.
  // Adding a route turns workers.dev off unless it is set explicitly, and the
  // *.workers.dev URL is worth keeping as a fallback.
  "routes": [{ "pattern": "news.jach.me", "custom_domain": true }],
  "workers_dev": true,

  "observability": { "enabled": true }
}
